# Copy this file to .env.mcp and fill in secrets.
# Keep .env.mcp out of version control. Never commit real tokens.

# Existing llmLibrarian runtime config
LLMLIBRARIAN_DB=/Users/tjm4/llmLibrarian/my_brain_db
LLMLIBRARIAN_MODEL=llama3.1:8b
LLMLIBRARIAN_CHUNK_SIZE=1000
LLMLIBRARIAN_CHUNK_OVERLAP=150
LLMLIBRARIAN_RERANK=0

# Linux only: cap glibc malloc arenas and lower the trim threshold so a
# long-lived MCP+torch process doesn't retain freed heap indefinitely (default
# is 8*ncpu arenas, which can bloat anon RSS into the tens of GB over hours of
# ingest churn). Safe to leave set on macOS — the runtime ignores them.
MALLOC_ARENA_MAX=2
MALLOC_TRIM_THRESHOLD_=131072

# Optional: Chroma server mode (safe MCP + pal pull concurrently)
# LLMLIBRARIAN_CHROMA_HOST=127.0.0.1
# LLMLIBRARIAN_CHROMA_PORT=8000

# MCP network serving config
# Bind loopback by default. LAN/tailnet bind is explicit; public exposure
# (Tailscale Funnel / port forwards) is not supported. URL path is routing
# only — not a security control.
LLMLIBRARIAN_MCP_TRANSPORT=streamable-http
LLMLIBRARIAN_MCP_HOST=127.0.0.1
LLMLIBRARIAN_MCP_PORT=8765
LLMLIBRARIAN_MCP_PATH=/mcp
LLMLIBRARIAN_MCP_STATELESS_HTTP=true
LLMLIBRARIAN_MCP_LOG_LEVEL=warning

# Auth is required by default (fail closed). The server refuses to start HTTP
# MCP if auth is on and no token is configured. /healthz stays open.
LLMLIBRARIAN_MCP_REQUIRE_AUTH=true
# Generate: openssl rand -hex 32
LLMLIBRARIAN_MCP_AUTH_TOKEN=replace_me
# Optional scope override for the single token above (default: read).
# Include write only for an operator/pal token when write tools are enabled.
# LLMLIBRARIAN_MCP_AUTH_TOKEN_SCOPES=read
#
# Preferred multi-caller form (one token per consumer). Example shape only:
# LLMLIBRARIAN_MCP_AUTH_TOKENS={"hermes":{"token":"replace_me_hermes","scopes":["read"]},"pal":{"token":"replace_me_pal","scopes":["read","write"]}}

# Write tools (add_silo, trigger_reindex, repair_silo, update_file, remove_file,
# set_silo_privacy) are disabled unless explicitly enabled AND the caller token
# has the write scope. Default deployment is read-only.
LLMLIBRARIAN_MCP_ENABLE_WRITE_TOOLS=false
