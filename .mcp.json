{
  "mcpServers": {
    "llmLibrarian": {
      "command": "uv",
      "args": ["--directory", "${LLMLIBRARIAN_HOME:-.}", "run", "mcp_server.py"],
      "env": {
        "LLMLIBRARIAN_DB": "${LLMLIBRARIAN_DB:-./my_brain_db}",
        "LLMLIBRARIAN_CHROMA_HOST": "127.0.0.1",
        "LLMLIBRARIAN_CHROMA_PORT": "8000",
        "LLMLIBRARIAN_MODEL": "llama3.2:latest",
        "LLMLIBRARIAN_CHUNK_SIZE": "1000",
        "LLMLIBRARIAN_CHUNK_OVERLAP": "150",
        "LLMLIBRARIAN_RERANK": "0"
      }
    }
  }
}
