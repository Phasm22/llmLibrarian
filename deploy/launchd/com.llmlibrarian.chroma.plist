<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.llmlibrarian.chroma</string>

  <!-- Rendered to the llmLibrarian.app launcher when the bundle installs
       (System Settings then shows "llmLibrarian" instead of the script name),
       else to {{INSTALL_DIR}}/scripts/run_chroma_server.sh directly. -->
  <key>ProgramArguments</key>
  <array>
    <string>{{CHROMA_PROGRAM}}</string>
  </array>

  <key>WorkingDirectory</key>
  <string>{{INSTALL_DIR}}</string>

  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>

  <!-- launchd's default soft limit (256) is too low for a Chroma server that
       fields concurrent connections from MCP + N watch daemons + interactive
       clients; each is a socket fd plus the server's own SQLite/HNSW handles. -->
  <key>SoftResourceLimits</key>
  <dict>
    <key>NumberOfFiles</key>
    <integer>8192</integer>
  </dict>
  <key>HardResourceLimits</key>
  <dict>
    <key>NumberOfFiles</key>
    <integer>8192</integer>
  </dict>

  <key>StandardOutPath</key>
  <string>{{LOG_DIR}}/llmlibrarian-chroma.stdout.log</string>
  <key>StandardErrorPath</key>
  <string>{{LOG_DIR}}/llmlibrarian-chroma.stderr.log</string>

  <key>ProcessType</key>
  <string>Standard</string>

  <!-- Group under /Applications/llmLibrarian.app in System Settings > Login
       Items instead of "run_chroma_server.sh - unidentified developer"
       (see scripts/install_app_bundle.sh; harmless if the app is absent). -->
  <key>AssociatedBundleIdentifiers</key>
  <array>
    <string>com.llmlibrarian.app</string>
  </array>
</dict>
</plist>
