{
  "mcpServers": {
    "llmLibrarian": {
      "command": "uv",
      "args": ["run", "--python", ">=3.10,<3.14", "mcp_server.py"],
      "env": {
        "LLMLIBRARIAN_DB": "${LLMLIBRARIAN_DB:-./my_brain_db}",
        "LLMLIBRARIAN_MODEL": "${LLMLIBRARIAN_MODEL:-llama3.1:8b}",
        "LLMLIBRARIAN_CHUNK_SIZE": "1000",
        "LLMLIBRARIAN_CHUNK_OVERLAP": "150",
        "LLMLIBRARIAN_RERANK": "0"
      }
    }
  }
}
